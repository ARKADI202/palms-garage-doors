# Copy this file to ".env" and fill in the values, then run: python follow.py

# From https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The person you want to follow, as their @username (the @ is optional).
TARGET_USERNAME=@someusername

# Optional: limit watching to ONE chat. Leave blank to match the target in any
# chat you share with them. To get the id, run: python list_chats.py
# You can also use the chat's @username or a t.me invite link.
SOURCE_CHAT=

# Name of the local login session file (created automatically). Keep it private.
SESSION_NAME=follow_session
